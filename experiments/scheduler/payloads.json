{
  "ebpf:collector_metadata": {
    "type": "object",
    "fields": {
      "capture": {
        "type": "string"
      },
      "max_nodes": {
        "type": "integer64"
      }
    },
    "required": [
      "capture",
      "max_nodes"
    ]
  },
  "ebpf:enqueue_entity": {
    "type": "object",
    "fields": {
      "event_info": {
        "type": "object",
        "fields": {
          "name": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "probe": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "phase",
          "probe"
        ]
      },
      "state": {
        "type": "object",
        "fields": {
          "runqueue": {
            "type": "object",
            "fields": {
              "address": {
                "type": "hex"
              },
              "nr_running": {
                "type": "integer64"
              },
              "root": {
                "type": "hex",
                "nullable": true
              },
              "leftmost": {
                "type": "hex",
                "nullable": true
              },
              "enqueued_entity": {
                "type": "object",
                "fields": {
                  "address": {
                    "type": "hex"
                  },
                  "rb_node": {
                    "type": "hex"
                  }
                },
                "required": [
                  "address",
                  "rb_node"
                ]
              },
              "node_count": {
                "type": "integer64"
              },
              "truncated": {
                "type": "boolean"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "fields": {
                    "address": {
                      "type": "hex"
                    },
                    "left": {
                      "type": "hex",
                      "nullable": true
                    },
                    "right": {
                      "type": "hex",
                      "nullable": true
                    },
                    "pid": {
                      "type": "integer64"
                    },
                    "color": {
                      "type": "string"
                    },
                    "comm": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "address",
                    "color",
                    "comm",
                    "left",
                    "right",
                    "pid"
                  ]
                }
              }
            },
            "required": [
              "address",
              "enqueued_entity",
              "leftmost",
              "node_count",
              "nodes",
              "nr_running",
              "root",
              "truncated"
            ]
          }
        },
        "required": [
          "runqueue"
        ]
      },
      "producer_sequence": {
        "type": "integer64"
      }
    },
    "required": [
      "event_info",
      "producer_sequence",
      "state"
    ]
  },
